# PostgreSQL (pgvector)
POSTGRES_DB=recall
POSTGRES_USER=recall
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080

# LLM (BYO API key) — provider: anthropic | openai | google
RECALL_LLM_PROVIDER=anthropic
RECALL_LLM_API_KEY=
RECALL_LLM_BASE_URL=                       # 비면 provider 기본 URL 사용
RECALL_LLM_MODEL_STRONG=claude-opus-4-8
RECALL_LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
RECALL_LLM_MODEL_EMBED=voyage-3

# Embedding (BYO key) — 검색용 벡터 임베딩. 비면 stub(0벡터, 벡터 검색 무의미)
# provider: voyage | openai (openai는 dimensions=1024로 요청해 DB vector(1024)와 정합)
RECALL_EMBEDDING_PROVIDER=voyage
RECALL_EMBEDDING_API_KEY=                   # 비면 VOYAGE_API_KEY로 폴백
RECALL_EMBEDDING_MODEL=                     # 비면 provider별 기본(voyage-3 / text-embedding-3-small)
RECALL_EMBEDDING_BASE_URL=                  # 비면 provider별 기본 URL
VOYAGE_API_KEY=                             # provider=voyage 하위호환(RECALL_EMBEDDING_API_KEY 미설정 시 사용)

# ── 멀티유저 SSO (Google OAuth2) ─────────────────────────────────────────────
# 로그인을 켜려면 SPRING_PROFILES_ACTIVE=oauth 로 두고 아래 셋을 채운다.
# 프로필이 스위치다 — 로그인·소유자 해석·CSRF 가 함께 켜진다(SecurityConfig javadoc).
# 비워 두면 부트스트랩 모드(인증 없음, 모든 데이터가 app_user.id=1 소유)로 동작한다.
SPRING_PROFILES_ACTIVE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 로그인 허용 이메일(쉼표 구분). oauth 프로필에서 비어 있으면 부팅을 막는다 —
# 비면 아무도 로그인할 수 없고 그 상태가 "로그인이 안 된다"는 증상으로만 나타난다.
RECALL_ALLOWED_EMAILS=

# 사용자 API 키를 DB에 저장할 때 쓰는 AES 마스터키(base64 32바이트).
# 없으면 키의 DB 영속을 거부한다(fail-closed) — UI 에서 키를 넣어도 저장되지 않는다.
# 생성: openssl rand -base64 32   ·   바꾸면 저장된 키를 복호화할 수 없다.
RECALL_SECRET_KEY=

# Frontend
FRONTEND_PORT=3000
