{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(cd backend && ./gradlew:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(cd frontend && npm run:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/format-on-edit.sh" }
        ]
      }
    ]
  }
}
